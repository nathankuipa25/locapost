generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id          String   @id @default(cuid())
  title       String
  content     String
  contentJson Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}